{
  "_about": "Golden test set: bài toán đã biết đáp án chính xác, một hoặc nhiều ca cho MỖI verifier type. `expect` là kết luận verifier PHẢI trả về: true (claim đúng), false (claim sai), null (không phán định được). Ca `expect:false` quan trọng ngang ca `expect:true` — một verifier luôn nói true thì vô dụng.",
  "cases": [
    {"id": "solve_equation.ok", "type": "solve_equation", "expect": true,
     "note": "x^2-5x+6 có nghiệm {2,3}",
     "payload": {"equation": "x**2 - 5*x + 6", "variable": "x", "claimed_roots": [2, 3]}},
    {"id": "solve_equation.wrong_root", "type": "solve_equation", "expect": false,
     "payload": {"equation": "x**2 - 5*x + 6", "variable": "x", "claimed_roots": [2, 4]}},
    {"id": "solve_equation.missing_root", "type": "solve_equation", "expect": false,
     "note": "thiếu một nghiệm cũng phải bị bắt",
     "payload": {"equation": "x**2 - 5*x + 6", "variable": "x", "claimed_roots": [2]}},
    {"id": "solve_equation.double_root", "type": "solve_equation", "expect": true,
     "note": "degenerate: nghiệm kép chỉ kể một lần",
     "payload": {"equation": "x**2 - 4*x + 4", "variable": "x", "claimed_roots": [2]}},

    {"id": "simplify_equiv.ok", "type": "simplify_equiv", "expect": true,
     "payload": {"expr_a": "(a+b)**2", "expr_b": "a**2 + 2*a*b + b**2", "variables": ["a", "b"]}},
    {"id": "simplify_equiv.wrong", "type": "simplify_equiv", "expect": false,
     "payload": {"expr_a": "(a+b)**2", "expr_b": "a**2 + b**2", "variables": ["a", "b"]}},

    {"id": "derivative.ok", "type": "derivative", "expect": true,
     "payload": {"function": "sin(x**2 + 1)", "variable": "x", "claimed_derivative": "2*x*cos(x**2 + 1)"}},
    {"id": "derivative.chain_rule_missed", "type": "derivative", "expect": false,
     "note": "quên nhân đạo hàm trong — lỗi kinh điển, phải bị bắt",
     "payload": {"function": "sin(x**2 + 1)", "variable": "x", "claimed_derivative": "cos(x**2 + 1)"}},
    {"id": "derivative.second_order", "type": "derivative", "expect": true,
     "payload": {"function": "x**4", "variable": "x", "claimed_derivative": "12*x**2", "order": 2}},

    {"id": "integral.definite_ok", "type": "integral", "expect": true,
     "note": "∫_0^1 x·e^x dx = 1",
     "payload": {"function": "x*exp(x)", "variable": "x", "lower": 0, "upper": 1, "claimed_value": "1"}},
    {"id": "integral.definite_wrong", "type": "integral", "expect": false,
     "payload": {"function": "x*exp(x)", "variable": "x", "lower": 0, "upper": 1, "claimed_value": "E"}},
    {"id": "integral.antiderivative_ok", "type": "integral", "expect": true,
     "payload": {"function": "1/x", "variable": "x", "claimed_antiderivative": "log(x)"}},
    {"id": "integral.antiderivative_wrong", "type": "integral", "expect": false,
     "payload": {"function": "1/x", "variable": "x", "claimed_antiderivative": "log(x)/2"}},
    {"id": "integral.volume_of_revolution", "type": "integral", "expect": true,
     "note": "π∫_{-3}^{3}(5-x²/3)² dx = 504π/5 — dạng câu hay gặp trong tài liệu lớp 12",
     "payload": {"function": "pi*(5-x**2/3)**2", "variable": "x", "lower": -3, "upper": 3, "claimed_value": "504*pi/5"}},

    {"id": "limit.ok", "type": "limit", "expect": true,
     "payload": {"function": "sin(x)/x", "variable": "x", "point": 0, "claimed_value": 1}},
    {"id": "limit.wrong", "type": "limit", "expect": false,
     "payload": {"function": "sin(x)/x", "variable": "x", "point": 0, "claimed_value": 0}},
    {"id": "limit.one_sided", "type": "limit", "expect": true,
     "payload": {"function": "1/x", "variable": "x", "point": 0, "direction": "+", "claimed_value": "oo"}},

    {"id": "trig_identity.ok", "type": "trig_identity", "expect": true,
     "payload": {"expr_a": "sin(x)**2 + cos(x)**2", "expr_b": "1"}},
    {"id": "trig_identity.wrong", "type": "trig_identity", "expect": false,
     "payload": {"expr_a": "sin(2*x)", "expr_b": "2*sin(x)"}},
    {"id": "trig_identity.double_angle", "type": "trig_identity", "expect": true,
     "payload": {"expr_a": "sin(2*x)", "expr_b": "2*sin(x)*cos(x)"}},

    {"id": "matrix_det.ok", "type": "matrix_det", "expect": true,
     "payload": {"matrix": [[1, 2], [3, 4]], "claimed": -2}},
    {"id": "matrix_det.sign_flip", "type": "matrix_det", "expect": false,
     "payload": {"matrix": [[1, 2], [3, 4]], "claimed": 2}},
    {"id": "matrix_det.singular", "type": "matrix_det", "expect": true,
     "note": "degenerate: ma trận suy biến, det = 0",
     "payload": {"matrix": [[1, 2], [2, 4]], "claimed": 0}},

    {"id": "matrix_rank.ok", "type": "matrix_rank", "expect": true,
     "payload": {"matrix": [[1, 2], [2, 4]], "claimed": 1}},
    {"id": "matrix_rank.wrong", "type": "matrix_rank", "expect": false,
     "payload": {"matrix": [[1, 2], [2, 4]], "claimed": 2}},

    {"id": "matrix_eigenvalues.ok", "type": "matrix_eigenvalues", "expect": true,
     "payload": {"matrix": [[2, 0], [0, 3]], "claimed": [2, 3]}},
    {"id": "matrix_eigenvalues.wrong", "type": "matrix_eigenvalues", "expect": false,
     "payload": {"matrix": [[2, 0], [0, 3]], "claimed": [1, 3]}},
    {"id": "matrix_eigenvalues.repeated", "type": "matrix_eigenvalues", "expect": true,
     "note": "degenerate: trị riêng bội 2 phải kể đủ số lần",
     "payload": {"matrix": [[5, 0], [0, 5]], "claimed": [5, 5]}},

    {"id": "matrix_inverse.ok", "type": "matrix_inverse", "expect": true,
     "payload": {"matrix": [[2, 0], [0, 2]], "claimed": [["1/2", 0], [0, "1/2"]]}},
    {"id": "matrix_inverse.wrong", "type": "matrix_inverse", "expect": false,
     "payload": {"matrix": [[2, 0], [0, 2]], "claimed": [[2, 0], [0, 2]]}},

    {"id": "matrix_multiply.ok", "type": "matrix_multiply", "expect": true,
     "payload": {"a": [[1, 2], [3, 4]], "b": [[1, 0], [0, 1]], "claimed": [[1, 2], [3, 4]]}},
    {"id": "matrix_multiply.wrong", "type": "matrix_multiply", "expect": false,
     "note": "nhân sai thứ tự/phần tử",
     "payload": {"a": [[1, 2], [3, 4]], "b": [[0, 1], [1, 0]], "claimed": [[1, 2], [3, 4]]}},

    {"id": "geometry_triangle.area_points", "type": "geometry_triangle", "expect": true,
     "note": "tam giác 3-4-5, diện tích 6",
     "payload": {"points": {"A": [0, 0], "B": [3, 0], "C": [0, 4]}, "property": "area", "expected": 6}},
    {"id": "geometry_triangle.area_wrong", "type": "geometry_triangle", "expect": false,
     "payload": {"points": {"A": [0, 0], "B": [3, 0], "C": [0, 4]}, "property": "area", "expected": 12}},
    {"id": "geometry_triangle.perimeter", "type": "geometry_triangle", "expect": true,
     "payload": {"points": {"A": [0, 0], "B": [3, 0], "C": [0, 4]}, "property": "perimeter", "expected": 12}},
    {"id": "geometry_triangle.is_right", "type": "geometry_triangle", "expect": true,
     "payload": {"sides": [3, 4, 5], "property": "is_right", "expected": true}},
    {"id": "geometry_triangle.not_right", "type": "geometry_triangle", "expect": false,
     "payload": {"sides": [3, 4, 6], "property": "is_right", "expected": true}},
    {"id": "geometry_triangle.heron", "type": "geometry_triangle", "expect": true,
     "payload": {"sides": [3, 4, 5], "property": "area", "expected": 6}},

    {"id": "analytic_geometry.point_line", "type": "analytic_geometry", "expect": true,
     "note": "d((1,1), 3x+4y-5=0) = |3+4-5|/5 = 0.4",
     "payload": {"operation": "distance_point_line_2d", "point": [1, 1], "line": [3, 4, -5], "expected": 0.4}},
    {"id": "analytic_geometry.point_line_wrong", "type": "analytic_geometry", "expect": false,
     "payload": {"operation": "distance_point_line_2d", "point": [1, 1], "line": [3, 4, -5], "expected": 2}},
    {"id": "analytic_geometry.point_plane", "type": "analytic_geometry", "expect": true,
     "note": "d((1,2,3), x+2y+2z-6=0) = |1+4+6-6|/3 = 5/3",
     "payload": {"operation": "distance_point_plane_3d", "point": [1, 2, 3], "plane": [1, 2, 2, -6],
                 "expected": 1.6666666666666667}},
    {"id": "analytic_geometry.perpendicular", "type": "analytic_geometry", "expect": true,
     "payload": {"operation": "perpendicular_lines_2d", "line1": [1, 0, 0], "line2": [0, 1, 0], "expected": true}},

    {"id": "counting.combination", "type": "counting", "expect": true,
     "payload": {"formula": "binomial(10, 4)", "expected": 210}},
    {"id": "counting.combination_wrong", "type": "counting", "expect": false,
     "payload": {"formula": "binomial(10, 4)", "expected": 200}},
    {"id": "counting.permutation", "type": "counting", "expect": true,
     "payload": {"formula": "factorial(10)/factorial(10-4)", "expected": 5040}},
    {"id": "counting.brute_force_disagrees", "type": "counting", "expect": false,
     "note": "công thức và đếm vét cạn lệch nhau ⇒ phải báo sai dù expected khớp công thức",
     "payload": {"formula": "binomial(5, 2)", "expected": 10,
                 "brute_force": {"kind": "permutation", "n": 5, "k": 2}}},

    {"id": "probability.ok", "type": "probability", "expect": true,
     "payload": {"formula": "1/6", "expected": 0.16666666666666666}},
    {"id": "probability.wrong", "type": "probability", "expect": false,
     "payload": {"formula": "1/6", "expected": 0.5}},
    {"id": "probability.out_of_range", "type": "probability", "expect": false,
     "note": "degenerate: xác suất > 1 phải bị loại bất kể expected",
     "payload": {"formula": "7/6", "expected": 1.1666666666666667}},

    {"id": "modular.gcd", "type": "modular", "expect": true,
     "payload": {"operation": "gcd", "a": 12, "b": 18, "expected": 6}},
    {"id": "modular.lcm", "type": "modular", "expect": true,
     "payload": {"operation": "lcm", "a": 4, "b": 6, "expected": 12}},
    {"id": "modular.mod_pow", "type": "modular", "expect": true,
     "payload": {"operation": "mod_pow", "base": 2, "exp": 10, "mod": 7, "expected": 2}},
    {"id": "modular.mod_pow_wrong", "type": "modular", "expect": false,
     "payload": {"operation": "mod_pow", "base": 2, "exp": 10, "mod": 7, "expected": 4}},
    {"id": "modular.mod_reduce", "type": "modular", "expect": true,
     "payload": {"operation": "mod_reduce", "a": 17, "mod": 5, "expected": 2}},
    {"id": "modular.fermat", "type": "modular", "expect": true,
     "payload": {"operation": "fermat_little_check", "a": 3, "p": 7, "expected": true}},

    {"id": "logic_equivalence.de_morgan", "type": "logic_equivalence", "expect": true,
     "payload": {"expr_a": "~(P & Q)", "expr_b": "~P | ~Q"}},
    {"id": "logic_equivalence.wrong", "type": "logic_equivalence", "expect": false,
     "payload": {"expr_a": "~(P & Q)", "expr_b": "~P & ~Q"}},

    {"id": "logic_negation.ok", "type": "logic_negation", "expect": true,
     "payload": {"expr": "P >> Q", "claimed_negation": "P & ~Q"}},
    {"id": "logic_negation.wrong", "type": "logic_negation", "expect": false,
     "payload": {"expr": "P >> Q", "claimed_negation": "~P & Q"}},

    {"id": "truth_table.ok", "type": "truth_table", "expect": true,
     "payload": {"expr": "P >> Q", "assignment": {"P": true, "Q": false}, "expected_value": false}},
    {"id": "truth_table.wrong", "type": "truth_table", "expect": false,
     "payload": {"expr": "P >> Q", "assignment": {"P": true, "Q": false}, "expected_value": true}},
    {"id": "truth_table.vacuous_truth", "type": "truth_table", "expect": true,
     "note": "degenerate: P sai ⇒ P→Q đúng",
     "payload": {"expr": "P >> Q", "assignment": {"P": false, "Q": false}, "expected_value": true}},

    {"id": "graph_property.complete", "type": "graph_property", "expect": true,
     "payload": {"property": "edges_complete", "n": 5, "expected": 10}},
    {"id": "graph_property.complete_wrong", "type": "graph_property", "expect": false,
     "payload": {"property": "edges_complete", "n": 5, "expected": 20}},
    {"id": "graph_property.bipartite", "type": "graph_property", "expect": true,
     "payload": {"property": "edges_complete_bipartite", "m": 3, "n": 4, "expected": 12}},
    {"id": "graph_property.is_connected", "type": "graph_property", "expect": true,
     "payload": {"property": "is_connected", "edges": [["a", "b"], ["b", "c"]], "expected": true}},
    {"id": "graph_property.disconnected", "type": "graph_property", "expect": true,
     "note": "degenerate: đỉnh cô lập ⇒ không liên thông",
     "payload": {"property": "is_connected", "edges": [["a", "b"]], "vertices": ["c"], "expected": false}},
    {"id": "graph_property.is_tree", "type": "graph_property", "expect": true,
     "payload": {"property": "is_tree", "edges": [["a", "b"], ["b", "c"]], "expected": true}},

    {"id": "tree_property.edges", "type": "tree_property", "expect": true,
     "payload": {"property": "edges_of_tree", "n": 7, "expected": 6}},
    {"id": "tree_property.edges_wrong", "type": "tree_property", "expect": false,
     "payload": {"property": "edges_of_tree", "n": 7, "expected": 7}},
    {"id": "tree_property.max_nodes", "type": "tree_property", "expect": true,
     "payload": {"property": "max_nodes_height_h", "h": 3, "expected": 15}},

    {"id": "recurrence.fibonacci", "type": "recurrence", "expect": true,
     "note": "F(10) = 55 với F(0)=0, F(1)=1",
     "payload": {"recurrence": [1, 1], "initial": [0, 1], "n": 10, "expected": 55}},
    {"id": "recurrence.wrong", "type": "recurrence", "expect": false,
     "payload": {"recurrence": [1, 1], "initial": [0, 1], "n": 10, "expected": 89}},
    {"id": "recurrence.closed_form", "type": "recurrence", "expect": true,
     "note": "a(n)=2a(n-1), a0=1 ⇒ a(n)=2^n",
     "payload": {"recurrence": [2], "initial": [1], "closed_form": "2**n", "crosscheck_n": [0, 1, 2, 3, 4, 5]}},
    {"id": "recurrence.closed_form_wrong", "type": "recurrence", "expect": false,
     "payload": {"recurrence": [2], "initial": [1], "closed_form": "2*n", "crosscheck_n": [0, 1, 2, 3, 4, 5]}},

    {"id": "numeric_eval.ok", "type": "numeric_eval", "expect": true,
     "payload": {"expr": "sqrt(2) * sqrt(3)", "expected_numeric": 2.449489742783178, "tolerance": 1e-6}},
    {"id": "numeric_eval.wrong", "type": "numeric_eval", "expect": false,
     "payload": {"expr": "sqrt(2) * sqrt(3)", "expected_numeric": 2.5, "tolerance": 1e-6}},
    {"id": "numeric_eval.tolerance_respected", "type": "numeric_eval", "expect": true,
     "note": "precision: chênh 1e-9 nằm trong dung sai 1e-6",
     "payload": {"expr": "1/3", "expected_numeric": 0.333333333, "tolerance": 1e-6}},
    {"id": "numeric_eval.tolerance_exceeded", "type": "numeric_eval", "expect": false,
     "note": "precision: chênh 1e-3 vượt dung sai 1e-6",
     "payload": {"expr": "1/3", "expected_numeric": 0.334, "tolerance": 1e-6}},
    {"id": "numeric_eval.integral_expression", "type": "numeric_eval", "expect": true,
     "payload": {"expr": "12 + integrate(t**2-6*t+5, (t, 0, 1))", "expected_numeric": 14.333333333333334,
                 "tolerance": 1e-6}},

    {"id": "none.skipped", "type": "none", "expect": null,
     "note": "câu khái niệm — không được giả vờ kiểm chứng",
     "payload": {}},
    {"id": "unknown_type.skipped", "type": "definitely_not_a_type", "expect": null,
     "payload": {"anything": 1}},
    {"id": "numeric_eval.empty_payload", "type": "numeric_eval", "expect": null,
     "note": "payload thiếu expr ⇒ không phán định, KHÔNG được mặc định là đúng",
     "payload": {}},
    {"id": "derivative.unparseable", "type": "derivative", "expect": null,
     "payload": {"function": "((((", "variable": "x", "claimed_derivative": "1"}}
  ]
}
