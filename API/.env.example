# Choose one provider: openrouter, openai, openai_compatible, or 9router.
AQG_LLM_PROVIDER=openrouter

# Option 1: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GENERATOR_MODEL=openai/gpt-4o-mini
OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Option 2: OpenAI
# AQG_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key
# OPENAI_GENERATOR_MODEL=gpt-4o-mini
# OPENAI_JUDGE_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option 3: 9Router / Codex CLI local OpenAI-compatible proxy
# AQG_LLM_PROVIDER=9router
# OPENAI_API_KEY=sk-your-local-proxy-key
# NINEROUTER_URL=http://127.0.0.1:20128
# NINEROUTER_KEY=optional-if-9router-auth-is-enabled
# NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
# NINEROUTER_GENERATOR_MODEL=cx/gpt-5.4
# NINEROUTER_JUDGE_MODEL=cx/gpt-5.4
# NINEROUTER_EMBEDDING_MODEL=<id from GET /v1/models/embedding>

# Optional global overrides, applied to either provider.
# AQG_GENERATOR_MODEL=
# AQG_JUDGE_MODEL=
# AQG_EMBEDDING_MODEL=

# ---- Web login (backend seeds this account at startup) ----
# Change ADMIN_PASSWORD then restart backend to rotate the password
# (all existing sessions of that user are revoked).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# PostgreSQL password (interpolated by docker-compose; DB stores users/sessions only)
POSTGRES_PASSWORD=change-me-too

# ---- Performance / quality knobs (optional) ----
# Run independent slots concurrently. Default 1 = sequential + deterministic.
# Set 3-4 to cut wall-clock ~3-5x on slow reasoning models (trades run-to-run
# accepted-set determinism for speed). Slots are I/O-bound on the LLM.
# AQG_PARALLEL_SLOT_WORKERS=3

# Quote-relevance strictness for the rule validator. Default (unset/0) = lenient:
# topical relevance is enforced by token overlap. Set 1 to restore the legacy
# strict formula-family gate (rejects computational questions whose source quote
# is only a definition/general rule — expect a much lower acceptance rate).
# AQG_QUOTE_RELEVANCE_STRICT=0
