# aqg6767.online — Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt)
# ngay khi DNS A record của domain trỏ về IP VPS.
aqg6767.online {
	# API backend: /api/* -> backend (bỏ prefix /api vì route backend nằm ở gốc)
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# Còn lại: frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}

# Vẫn cho truy cập trực tiếp bằng IP qua HTTP (dự phòng khi DNS trục trặc).
:80 {
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
